# Copy this file to server/.env for local development and fill in the values.
# On a host such as Render, add the same names as environment variables instead.
# Never commit the real .env file.

# Required. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required. For example: gemini-3.8-flash (check Google's models page for current names)
GEMINI_MODEL=

# Optional. A second model used when the main one is overloaded or over quota. For example: gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=
# Optional. Milliseconds to wait for Gemini before giving up. Default: 30000
GEMINI_TIMEOUT_MS=

# Origin(s) allowed to call this API, comma-separated, no trailing slash.
# Local default: http://localhost:5173
# Deployed example: https://your-app.vercel.app
CLIENT_ORIGIN=

# Local port. Hosts such as Render set this for you. Default: 3001
PORT=
