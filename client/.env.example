# Public, non-secret URL of the API server. Never put an API key here: everything with a VITE_ prefix
# is baked into the website and visible to every visitor.
#
# Leave empty for local development: the app then calls relative /api paths and the Vite proxy
# (client/vite.config.js) forwards them to the local server.
# On Vercel set it to your Render URL, for example: https://your-service.onrender.com
VITE_API_URL=
